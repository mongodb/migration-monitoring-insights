[Unit]
Description=Migration Insights - MongoDB Migration Monitoring Dashboard
After=network.target

[Service]
Type=simple
User=migration-insights
Group=migration-insights
ExecStart=/opt/migration-insights/migration-insights
WorkingDirectory=/opt/migration-insights
Environment=MI_LOG_FILE=/var/log/migration-insights/insights.log
EnvironmentFile=-/etc/migration-insights/env
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/migration-insights

StandardOutput=journal
StandardError=journal
SyslogIdentifier=migration-insights

[Install]
WantedBy=multi-user.target
